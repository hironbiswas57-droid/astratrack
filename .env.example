# ============================================================
#  AstraTrack AI - Environment Variable Template
#  ✅  Safe to commit. Contains NO real secrets.
#  Usage: Copy this file to .env and fill in your values.
#         cp .env.example .env
# ============================================================

# ── Server ───────────────────────────────────────────────────
ASTRATRACK_HOST=127.0.0.1
ASTRATRACK_PORT=8000
ASTRATRACK_ENV=development

# ── AI / LLM API Connection ──────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=

# ── Astronomy Data APIs ───────────────────────────────────────
NASA_API_KEY=
JPL_HORIZONS_BASE_URL=https://ssd.jpl.nasa.gov/api/horizons.api

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=*

# ── Local SSL / TLS (hosting providers terminate HTTPS at their edge) ──
SSL_CERT_PATH=certs/cert.pem
SSL_KEY_PATH=certs/key.pem

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
